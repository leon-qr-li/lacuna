#!/usr/bin/env bash
# Deploy the newest LACUNA image (systemd timer, every minute). Pull-based: the server needs no inbound port.
#   - never swaps while an import / export / publish job runs (the app's /api/app "busy" list)
#   - health-checks the new container; if it doesn't come up, goes back to the previous image and
#     remembers the bad one so it isn't retried until a newer image arrives
#   - the staging site runs the same script (lacuna-update-preview.service) with its own container name,
#     image, env file and data folder; LACUNA_SEED_FROM makes each new version start on a fresh copy of
#     the real workspace (decision staging-site), its audio hard-linked rather than copied (no extra disk)
# Status: /var/lib/lacuna/deploy.json. Tested with a fake docker in tests/test_deploy_host.py.
set -uo pipefail
STATE=${LACUNA_STATE_DIR:-/var/lib/lacuna}
mkdir -p "$STATE"
exec 9>"$STATE/update.lock"
flock -n 9 || exit 0
IMAGE=$(cat "${LACUNA_IMAGE_FILE:-/etc/lacuna/image}")
NAME=${LACUNA_NAME:-lacuna}
ENV_FILE=${LACUNA_ENV_FILE:-/etc/lacuna/lacuna.env}
DATA=${LACUNA_DATA:-/data}                      # mounted as /data in the container
LIMITS=${LACUNA_LIMITS:---memory 7g --pids-limit 512}
SEED_FROM=${LACUNA_SEED_FROM:-}                 # staging: copy this workspace in before each new version
HEALTH_WAIT=${HEALTH_WAIT:-180}

status() {  # status <state> <image> <message>
  jq -n --arg s "$1" --arg i "$2" --arg m "$3" --arg t "$(date -u +%FT%TZ)" \
    '{state:$s, image:$i, message:$m, at:$t}' > "$STATE/deploy.json.tmp" && mv "$STATE/deploy.json.tmp" "$STATE/deploy.json"
  echo "$1: $3"
}

in_app() {  # run python inside the app container against its own loopback (exempt from the Access check)
  docker exec "$NAME" python -c "$1" 2>/dev/null
}

healthy() {
  in_app "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/api/health', timeout=4).status == 200 else 1)"
}

busy() {
  in_app "import urllib.request,json; print(len(json.load(urllib.request.urlopen('http://127.0.0.1:8765/api/app', timeout=10)).get('busy') or []))"
}

start() {  # start <image id>
  docker rm -f "$NAME" >/dev/null 2>&1
  # shellcheck disable=SC2086  # LIMITS is a list of flags
  docker run -d --name "$NAME" --network lacuna --restart unless-stopped \
    --env-file "$ENV_FILE" -e TMPDIR=/data/tmp -v "$DATA:/data" \
    $LIMITS --security-opt no-new-privileges --cap-drop ALL \
    --stop-timeout 30 "$1" >/dev/null
}

# audio (by extension, any case): hard-linked into the staging copy, not copied; the app never writes an audio file
# in place (new files are written aside and renamed in), so staging can't change the real site's recordings
AUDIO_EXT="wav mp3 m4a aac flac ogg opus aif aiff"
audio_patterns() {  # audio_patterns <rsync|du>: one glob per extension, case-insensitive
  local e c pat
  for e in $AUDIO_EXT; do
    pat=""
    for (( i=0; i<${#e}; i++ )); do c=${e:i:1}; pat+="[${c}${c^^}]"; done
    if [ "$1" = du ]; then printf -- '--exclude=*.%s\n' "$pat"; else printf -- '*.%s\n' "$pat"; fi
  done
}

seed() {  # staging only: replace its workspace with a fresh copy of the real one (never the other way)
  [ -n "$SEED_FROM" ] || return 0
  local need have free pats dux
  mkdir -p "$DATA/workspace"
  mapfile -t pats < <(audio_patterns rsync)
  mapfile -t dux < <(audio_patterns du)
  # only what is copied counts: the audio is linked and takes no room
  need=$(du -sb --exclude=tmp "${dux[@]}" "$SEED_FROM" 2>/dev/null | cut -f1)
  have=$(du -sb "${dux[@]}" "$DATA/workspace" 2>/dev/null | cut -f1)
  free=$(df -B1 --output=avail "$DATA" | tail -1)
  if [ $(( ${need:-0} - ${have:-0} )) -gt $(( ${free:-0} - ${LACUNA_SEED_MARGIN:-2147483648} )) ]; then
    status no-space "$new" "not enough disk to copy the workspace for staging"
    return 1
  fi
  docker rm -f "$NAME" >/dev/null 2>&1
  mkdir -p "$DATA/workspace" "$DATA/home" "$DATA/tmp"
  local ex=() in=()
  for p in "${pats[@]}"; do ex+=(--exclude "$p"); in+=(--include "$p"); done
  # 1. everything but the audio, copied (the audio from last time goes too: it is linked afresh below)
  rsync -a --delete --delete-excluded --exclude /tmp/ "${ex[@]}" "$SEED_FROM/" "$DATA/workspace/" \
    || { status seed-failed "$new" "could not copy the workspace"; return 1; }
  # 2. the audio, as hard links to the real files (same disk; copied only if linking is impossible)
  rsync -a --link-dest="$SEED_FROM" --exclude /tmp/ --include '*/' "${in[@]}" --exclude '*' "$SEED_FROM/" "$DATA/workspace/" \
    || { status seed-failed "$new" "could not link the workspace's audio"; return 1; }
  chown -R "${LACUNA_OWNER:-10001:10001}" "$DATA"
}

wait_healthy() {
  for _ in $(seq 1 "$HEALTH_WAIT"); do
    healthy && return 0
    [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = true ] || return 1
    sleep "${HEALTH_POLL:-1}"
  done
  return 1
}

docker pull -q "$IMAGE" >/dev/null 2>&1 || { status pull-failed "" "could not pull $IMAGE"; exit 0; }
new=$(docker image inspect -f '{{.Id}}' "$IMAGE")
cur=$(docker inspect -f '{{.Image}}' "$NAME" 2>/dev/null || true)
running=$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null || echo false)

if [ "$new" = "$cur" ] && [ "$running" = true ]; then
  exit 0
fi
if [ "$new" = "$(cat "$STATE/bad-image" 2>/dev/null)" ]; then
  if [ "$running" != true ] && [ -n "$cur" ]; then start "$cur"; fi
  exit 0
fi
if [ "$running" = true ] && [ -n "$cur" ]; then
  n=$(busy)
  if [ "${n:-0}" != 0 ]; then
    status waiting "$new" "$n job(s) running; deploying when they finish"
    exit 0
  fi
fi

seed || exit 0
status deploying "$new" "starting the new version"
start "$new"
if wait_healthy; then
  echo "$cur" > "$STATE/previous-image"
  # keep the previous version on disk under a name, so the next rollback still has it after the prune
  if [ -n "$cur" ] && [ "$cur" != "$new" ]; then docker tag "$cur" lacuna:previous >/dev/null 2>&1; fi
  rm -f "$STATE/bad-image"
  status deployed "$new" "$(docker exec "$NAME" cat /app/VERSION 2>/dev/null)"
  docker image prune -f >/dev/null 2>&1
  exit 0
fi

docker logs --tail 80 "$NAME" > "$STATE/failed-start.log" 2>&1
echo "$new" > "$STATE/bad-image"
if [ -n "$cur" ]; then
  start "$cur"
  if wait_healthy; then
    status rolled-back "$cur" "new version did not start; back on the previous one"
  else
    status down "$cur" "new version did not start and the previous one did not come back"
  fi
else
  status down "$new" "first version did not start"
fi
exit 1
